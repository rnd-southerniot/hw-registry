# Normalize line endings: LF in repo, OS-native in working tree.
* text=auto eol=lf

# --- Git LFS --------------------------------------------------------------
# Datasheets (we LINK to them, but if a vendor PDF is ever vendored
# locally — e.g. for an air-gap drop — it goes through LFS).
*.pdf  filter=lfs diff=lfs merge=lfs -text

# Mechanical / 3D
*.step filter=lfs diff=lfs merge=lfs -text
*.stp  filter=lfs diff=lfs merge=lfs -text
*.wrl  filter=lfs diff=lfs merge=lfs -text

# Bitmap images. SVG stays as text (diffable, no LFS).
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
