root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown: keep trailing whitespace (line breaks via two-space hack).
trim_trailing_whitespace = false
indent_size = 2

[Makefile]
indent_style = tab

[*.{json,toml}]
indent_size = 2
