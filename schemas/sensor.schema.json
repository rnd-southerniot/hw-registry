{
  "$comment": "SPDX-License-Identifier: CC-BY-4.0",
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Reference to a file living inside the repo (potentially under LFS).",
      "properties": {
        "lfs": {
          "default": false,
          "description": "True if this asset is stored via Git LFS (binary > 500 KB).",
          "title": "Lfs",
          "type": "boolean"
        },
        "license": {
          "description": "SPDX identifier for this asset (e.g. CC-BY-4.0, MIT, vendor-redistribution).",
          "title": "License",
          "type": "string"
        },
        "path": {
          "description": "Repo-relative path (e.g. assets/sensors/sht41/pinout.svg).",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "license"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetBundle": {
      "additionalProperties": false,
      "description": "Aggregate of datasheet plus optional pinout and additional assets.",
      "properties": {
        "additional": {
          "description": "Other linked assets (3D models, KiCad projects, application notes).",
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Additional",
          "type": "array"
        },
        "datasheet": {
          "$ref": "#/$defs/Datasheet",
          "description": "Primary datasheet reference."
        },
        "pinout_svg": {
          "anyOf": [
            {
              "$ref": "#/$defs/Asset"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Auto-generated SVG pinout (CC-BY-4.0). Populated by tools/render_pinout.py."
        }
      },
      "required": [
        "datasheet"
      ],
      "title": "AssetBundle",
      "type": "object"
    },
    "CurrentDraw": {
      "additionalProperties": false,
      "description": "Typical and worst-case current consumption.",
      "properties": {
        "max_mA": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Worst-case operating current in mA.",
          "title": "Max Ma"
        },
        "sleep_uA": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deep-sleep current in \u00b5A.",
          "title": "Sleep Ua"
        },
        "typical_mA": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Typical operating current in mA.",
          "title": "Typical Ma"
        }
      },
      "title": "CurrentDraw",
      "type": "object"
    },
    "Datasheet": {
      "additionalProperties": false,
      "description": "Manufacturer datasheet pointer with archival fallback.",
      "properties": {
        "archived_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "web.archive.org snapshot for offline / link-rot resilience.",
          "title": "Archived Url"
        },
        "primary_url": {
          "description": "Vendor-hosted authoritative URL.",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Primary Url",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the PDF when archived locally; null if linking only.",
          "title": "Sha256"
        }
      },
      "required": [
        "primary_url"
      ],
      "title": "Datasheet",
      "type": "object"
    },
    "Electrical": {
      "additionalProperties": false,
      "description": "Aggregate electrical specifications for a component.",
      "properties": {
        "current_draw": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurrentDraw"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Typical and worst-case current draw."
        },
        "logic": {
          "$ref": "#/$defs/LogicSpec"
        },
        "power_budget_mA": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total power budget at the board / module level in mA.",
          "title": "Power Budget Ma"
        },
        "vcc": {
          "$ref": "#/$defs/VccSpec"
        }
      },
      "required": [
        "vcc",
        "logic"
      ],
      "title": "Electrical",
      "type": "object"
    },
    "ExternalRefs": {
      "additionalProperties": false,
      "description": "Distributor and catalog cross-references.",
      "properties": {
        "digikey_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digi-Key part number.",
          "title": "Digikey Pn"
        },
        "jlcpcb_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JLCPCB LCSC part number (e.g. C12345).",
          "title": "Jlcpcb Pn"
        },
        "mouser_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mouser part number.",
          "title": "Mouser Pn"
        },
        "nexar_part_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nexar GraphQL part ID.",
          "title": "Nexar Part Id"
        },
        "octopart_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Octopart canonical URL.",
          "title": "Octopart Url"
        }
      },
      "title": "ExternalRefs",
      "type": "object"
    },
    "Interface": {
      "additionalProperties": false,
      "description": "Communication / signal interface for a sensor or peripheral.",
      "properties": {
        "analog_input_range_v": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Input range as (min_v, max_v).",
          "title": "Analog Input Range V"
        },
        "analog_resolution_bits": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ADC/DAC resolution in bits.",
          "title": "Analog Resolution Bits"
        },
        "i2c_address": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default I2C address (7-bit, decimal). Use 0xNN syntax in YAML.",
          "title": "I2C Address"
        },
        "i2c_address_options": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Selectable addresses via ADDR pin / strap (7-bit values).",
          "title": "I2C Address Options"
        },
        "i2c_max_clock_khz": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum I2C bus clock the device tolerates, in kHz.",
          "title": "I2C Max Clock Khz"
        },
        "i2c_pullups_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True if the device does not integrate I2C pull-ups.",
          "title": "I2C Pullups Required"
        },
        "onewire_parasite_power": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True if the device supports parasite-power mode.",
          "title": "Onewire Parasite Power"
        },
        "pwm_max_freq_hz": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum PWM frequency in Hz.",
          "title": "Pwm Max Freq Hz"
        },
        "spi_max_clock_mhz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Max SPI clock in MHz.",
          "title": "Spi Max Clock Mhz"
        },
        "spi_mode": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SPI mode 0\u20133 (CPOL/CPHA).",
          "title": "Spi Mode"
        },
        "type": {
          "description": "Bus or signal protocol family.",
          "enum": [
            "i2c",
            "spi",
            "uart",
            "onewire",
            "analog",
            "pwm"
          ],
          "title": "Type",
          "type": "string"
        },
        "uart_baud_default": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default baud rate.",
          "title": "Uart Baud Default"
        },
        "uart_max_baud": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum supported baud rate.",
          "title": "Uart Max Baud"
        }
      },
      "required": [
        "type"
      ],
      "title": "Interface",
      "type": "object"
    },
    "KicadRefs": {
      "additionalProperties": false,
      "description": "KiCad symbol, footprint, and 3D model pointers.",
      "properties": {
        "footprint": {
          "description": "Library:footprint path (e.g. hw-registry:DFN-4-1EP_2x2mm).",
          "title": "Footprint",
          "type": "string"
        },
        "model_3d": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "3D model path relative to repo root (typically under LFS).",
          "title": "Model 3D"
        },
        "symbol": {
          "description": "Library:symbol path (e.g. hw-registry:SHT41).",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "footprint"
      ],
      "title": "KicadRefs",
      "type": "object"
    },
    "LogicSpec": {
      "additionalProperties": false,
      "description": "Digital I/O voltage levels.",
      "properties": {
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Logic family identifier (e.g. CMOS, LVTTL).",
          "title": "Family"
        },
        "five_v_tolerant": {
          "default": false,
          "description": "True if I/O pins tolerate 5 V signals despite VCCIO < 5 V.",
          "title": "Five V Tolerant",
          "type": "boolean"
        },
        "voltage_v": {
          "description": "I/O voltage in volts (typically 1.8, 3.3, or 5.0).",
          "title": "Voltage V",
          "type": "number"
        }
      },
      "required": [
        "voltage_v"
      ],
      "title": "LogicSpec",
      "type": "object"
    },
    "Package": {
      "additionalProperties": false,
      "description": "Physical package envelope.",
      "properties": {
        "dimensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageDimensions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Outer physical dimensions."
        },
        "pin_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total pin or pad count (null for shielded modules where exposed pads are the contract).",
          "title": "Pin Count"
        },
        "pitch_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pin-to-pin pitch in millimetres.",
          "title": "Pitch Mm"
        },
        "type": {
          "description": "Package family (e.g. QFN-32, MSOP-10, LCC-WROOM-1, BGA-484).",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Package",
      "type": "object"
    },
    "PackageDimensions": {
      "additionalProperties": false,
      "description": "Outer dimensions of the physical package in millimetres.",
      "properties": {
        "height_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Height (z-axis) in mm.",
          "title": "Height Mm"
        },
        "length_mm": {
          "description": "Length along the longest axis in mm.",
          "title": "Length Mm",
          "type": "number"
        },
        "width_mm": {
          "description": "Width along the shorter axis in mm.",
          "title": "Width Mm",
          "type": "number"
        }
      },
      "required": [
        "length_mm",
        "width_mm"
      ],
      "title": "PackageDimensions",
      "type": "object"
    },
    "SensorConstraints": {
      "additionalProperties": false,
      "description": "Operating envelope and metrology constraints.",
      "properties": {
        "accuracy": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accuracy spec per measurand (e.g. {temp_c: '\u00b10.2', rh_pct: '\u00b11.8'}).",
          "title": "Accuracy"
        },
        "active_current_uA": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Active conversion current in \u00b5A.",
          "title": "Active Current Ua"
        },
        "measurement_range": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sensor-specific measurement bounds (e.g. {humidity_pct: '0-100'}).",
          "title": "Measurement Range"
        },
        "operating_temp_c": {
          "anyOf": [
            {
              "$ref": "#/$defs/TempRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Operating temperature range."
        },
        "response_time_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Response time \u03c4\u2086\u2083 in ms.",
          "title": "Response Time Ms"
        },
        "sleep_current_uA": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sleep current in \u00b5A.",
          "title": "Sleep Current Ua"
        },
        "storage_temp_c": {
          "anyOf": [
            {
              "$ref": "#/$defs/TempRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Storage / handling temperature range."
        },
        "supply_voltage_v": {
          "anyOf": [
            {
              "$ref": "#/$defs/VoltageRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Acceptable VDD range. Often duplicates electrical.vcc.{min,max}_v."
        }
      },
      "title": "SensorConstraints",
      "type": "object"
    },
    "TempRange": {
      "additionalProperties": false,
      "description": "Temperature range in degrees Celsius.",
      "properties": {
        "max_c": {
          "description": "Maximum temperature in \u00b0C.",
          "title": "Max C",
          "type": "number"
        },
        "min_c": {
          "description": "Minimum temperature in \u00b0C.",
          "title": "Min C",
          "type": "number"
        }
      },
      "required": [
        "min_c",
        "max_c"
      ],
      "title": "TempRange",
      "type": "object"
    },
    "Tested": {
      "additionalProperties": false,
      "description": "POC sign-off record. Required on every component.",
      "properties": {
        "by": {
          "description": "Engineer who signed off (email or GitHub handle).",
          "title": "By",
          "type": "string"
        },
        "date": {
          "description": "Sign-off date in ISO 8601 format (YYYY-MM-DD).",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "POC evidence \u2014 repo URL, photo path, or short note. Required by PR template for production-tested.",
          "title": "Evidence"
        },
        "status": {
          "description": "POC verification status.",
          "enum": [
            "experimental",
            "stable",
            "production-tested",
            "stub"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "by",
        "date"
      ],
      "title": "Tested",
      "type": "object"
    },
    "VccSpec": {
      "additionalProperties": false,
      "description": "Supply voltage rail.",
      "properties": {
        "max_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum acceptable supply voltage in volts.",
          "title": "Max V"
        },
        "min_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum acceptable supply voltage in volts.",
          "title": "Min V"
        },
        "nominal_v": {
          "description": "Nominal supply voltage in volts.",
          "title": "Nominal V",
          "type": "number"
        }
      },
      "required": [
        "nominal_v"
      ],
      "title": "VccSpec",
      "type": "object"
    },
    "VoltageRange": {
      "additionalProperties": false,
      "description": "Voltage range in volts.",
      "properties": {
        "max_v": {
          "description": "Maximum voltage in volts.",
          "title": "Max V",
          "type": "number"
        },
        "min_v": {
          "description": "Minimum voltage in volts.",
          "title": "Min V",
          "type": "number"
        }
      },
      "required": [
        "min_v",
        "max_v"
      ],
      "title": "VoltageRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A sensor or analog front-end IC.",
  "properties": {
    "apiVersion": {
      "const": "hwreg/v1",
      "description": "Schema API version. Pinned to hwreg/v1; bumping requires a v2 migration.",
      "title": "Apiversion",
      "type": "string"
    },
    "assets": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetBundle"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "code_owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "GitHub team or handle responsible for this component.",
      "title": "Code Owner"
    },
    "constraints": {
      "$ref": "#/$defs/SensorConstraints",
      "description": "Operating envelope and metrology."
    },
    "drivers": {
      "description": "Driver component refs (e.g. drivers/sensirion/sht41).",
      "items": {
        "pattern": "^[a-z]+/[a-z0-9-]+/[a-z0-9-]+(?:@\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)?$",
        "type": "string"
      },
      "title": "Drivers",
      "type": "array"
    },
    "electrical": {
      "$ref": "#/$defs/Electrical",
      "description": "Electrical specs."
    },
    "external_refs": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExternalRefs"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "description": "Slug kind/vendor/part. MUST equal the relative path under library/ minus .yaml.",
      "pattern": "^[a-z]+/[a-z0-9-]+/[a-z0-9-]+$",
      "title": "Id",
      "type": "string"
    },
    "inherits_from": {
      "items": {
        "pattern": "^[a-z]+/[a-z0-9-]+/[a-z0-9-]+(?:@\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)?$",
        "type": "string"
      },
      "title": "Inherits From",
      "type": "array"
    },
    "interface": {
      "$ref": "#/$defs/Interface",
      "description": "Primary communication interface."
    },
