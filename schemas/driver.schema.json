{
  "$comment": "SPDX-License-Identifier: CC-BY-4.0",
  "$defs": {
    "DriverBinding": {
      "additionalProperties": false,
      "description": "A per-framework binding describing how to consume the driver in a project.\n\nMost fields are framework-conditional and optional. Authors populate\nonly what their framework's manifest needs:\n\n- ESP-IDF: ``component`` + ``source`` (Component Manager)\n- Arduino: ``library`` + ``package_index``\n- Zephyr: ``compatible`` + ``binding`` + ``kconfig``\n- MicroPython: ``module`` + ``install``\n\n``tested_with`` is intentionally a list \u2014 drivers get tested against\nmultiple framework versions over time. Section 3.4 of BLUEPRINT.md\nshows it as a single string; that example is wrong (override recorded\nin Appendix A).",
      "properties": {
        "binding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Zephyr DT binding path (e.g. dts/bindings/sensor/sensirion,sht4x.yaml).",
          "title": "Binding"
        },
        "compatible": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Zephyr Devicetree `compatible` string (e.g. 'sensirion,sht4x').",
          "title": "Compatible"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ESP-IDF component manifest ID (e.g. espressif/esp_ads111x).",
          "title": "Component"
        },
        "framework": {
          "description": "Target firmware framework.",
          "enum": [
            "esp-idf",
            "arduino",
            "zephyr",
            "micropython",
            "platformio"
          ],
          "title": "Framework",
          "type": "string"
        },
        "header": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public header file to #include (e.g. sht4x.h).",
          "title": "Header"
        },
        "install": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MicroPython install command (e.g. 'mip install adafruit-sht4x').",
          "title": "Install"
        },
        "kconfig": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Zephyr Kconfig symbol (e.g. CONFIG_SHT4X).",
          "title": "Kconfig"
        },
        "library": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arduino library name (e.g. Adafruit_ADS1X15).",
          "title": "Library"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SPDX identifier of the upstream driver library (e.g. MIT, Apache-2.0, BSD-3-Clause). Optional \u2014 some upstream libraries do not publish a clear license.",
          "title": "License"
        },
        "module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MicroPython module name (e.g. adafruit_sht4x).",
          "title": "Module"
        },
        "package_index": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arduino board / library package-index identifier (e.g. 'arduino', 'esp32').",
          "title": "Package Index"
        },
        "sample_call": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One-line idiomatic call sample (e.g. 'sht4x_get_measurement(dev, &t, &rh);').",
          "title": "Sample Call"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source URL \u2014 git repo, registry URL, or 'core' if shipped with the framework.",
          "title": "Source"
        },
        "tested_with": {
          "description": "Framework versions verified by hand (e.g. ['esp-idf 5.5', 'arduino-esp32 3.0.1']).",
          "items": {
            "type": "string"
          },
          "title": "Tested With",
          "type": "array"
        },
        "version_constraint": {
          "description": "Version constraint in framework-native syntax (semver range, npm-style, PEP440).",
          "title": "Version Constraint",
          "type": "string"
        }
      },
      "required": [
        "framework",
        "version_constraint"
      ],
      "title": "DriverBinding",
      "type": "object"
    },
    "Tested": {
      "additionalProperties": false,
      "description": "POC sign-off record. Required on every component.",
      "properties": {
        "by": {
          "description": "Engineer who signed off (email or GitHub handle).",
          "title": "By",
          "type": "string"
        },
        "date": {
          "description": "Sign-off date in ISO 8601 format (YYYY-MM-DD).",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "POC evidence \u2014 repo URL, photo path, or short note. Required by PR template for production-tested.",
          "title": "Evidence"
        },
        "status": {
          "description": "POC verification status.",
          "enum": [
            "stub",
            "verified",
            "production-tested"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "by",
        "date"
      ],
      "title": "Tested",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A driver \u2014 pointer + version constraints across one or more frameworks.",
  "properties": {
    "apiVersion": {
      "const": "hwreg/v1",
      "description": "Schema API version. Pinned to hwreg/v1; bumping requires a v2 migration.",
      "title": "Apiversion",
      "type": "string"
    },
    "applies_to": {
      "description": "Component refs this driver supports (sensors, chips, modules). Unversioned.",
      "items": {
        "pattern": "^[a-z]+/[a-z0-9-]+/[a-z0-9-]+(?:@\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)?$",
        "type": "string"
      },
      "title": "Applies To",
      "type": "array"
    },
    "bindings": {
      "description": "Per-framework bindings; at least one required.",
      "items": {
        "$ref": "#/$defs/DriverBinding"
      },
      "minItems": 1,
      "title": "Bindings",
      "type": "array"
    },
    "code_owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "GitHub team or handle responsible for this component.",
      "title": "Code Owner"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional paragraph-form description (\u2264 500 chars). Use summary for the one-liner.",
      "title": "Description"
    },
    "id": {
      "description": "Slug kind/vendor/part. MUST equal the relative path under library/ minus .yaml.",
      "pattern": "^[a-z]+/[a-z0-9-]+/[a-z0-9-]+$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "driver",
      "default": "driver",
      "title": "Kind",
      "type": "string"
    },
    "lifecycle": {
      "description": "Lifecycle stage. Drives deprecation surfacing for downstream consumers.",
      "enum": [
        "experimental",
        "stable",
        "deprecated",
        "eol",
        "archived"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "revision": {
      "description": "Component revision in SemVer 2.0. MAJOR=pin/electrical break, MINOR=behavior, PATCH=errata.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Revision",
      "type": "string"
    },
    "summary": {
      "description": "One-line human description (\u2264 120 characters).",
      "maxLength": 120,
      "title": "Summary",
      "type": "string"
    },
    "tags": {
      "description": "Free-form tags powering MCP search faceting (e.g. wifi, ble, lorawan, lx7).",
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "tested": {
      "$ref": "#/$defs/Tested",
      "description": "POC sign-off record."
    }
  },
  "required": [
    "apiVersion",
    "id",
    "revision",
    "summary",
    "tested",
    "lifecycle",
    "applies_to",
    "bindings"
  ],
  "title": "Driver",
  "type": "object"
}
