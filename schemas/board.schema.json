{
  "$comment": "SPDX-License-Identifier: CC-BY-4.0",
  "$defs": {
    "AltFunction": {
      "additionalProperties": false,
      "description": "Mux-selectable peripheral function on a pin.",
      "properties": {
        "channel": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Peripheral channel or index (e.g. ADC1 channel 7).",
          "title": "Channel"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "in",
                "out",
                "bidir"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Signal direction relative to the device (in / out / bidir).",
          "title": "Direction"
        },
        "function": {
          "description": "Function identifier (e.g. gpio, i2c_sda, spi_mosi, adc_in, uart_tx).",
          "title": "Function",
          "type": "string"
        },
        "open_drain": {
          "default": false,
          "description": "True if the function is open-drain (e.g. I\u00b2C SDA/SCL).",
          "title": "Open Drain",
          "type": "boolean"
        },
        "peripheral": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Peripheral instance owning this function (e.g. i2c0, spi2, adc1).",
          "title": "Peripheral"
        }
      },
      "required": [
        "function"
      ],
      "title": "AltFunction",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "description": "Reference to a file living inside the repo (potentially under LFS).",
      "properties": {
        "lfs": {
          "default": false,
          "description": "True if this asset is stored via Git LFS (binary > 500 KB).",
          "title": "Lfs",
          "type": "boolean"
        },
        "license": {
          "description": "SPDX identifier for this asset (e.g. CC-BY-4.0, MIT, vendor-redistribution).",
          "title": "License",
          "type": "string"
        },
        "path": {
          "description": "Repo-relative path (e.g. assets/sensors/sht41/pinout.svg).",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "license"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetBundle": {
      "additionalProperties": false,
      "description": "Aggregate of datasheet plus optional pinout and additional assets.",
      "properties": {
        "additional": {
          "description": "Other linked assets (3D models, KiCad projects, application notes).",
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Additional",
          "type": "array"
        },
        "datasheet": {
          "$ref": "#/$defs/Datasheet",
          "description": "Primary datasheet reference."
        },
        "pinout_svg": {
          "anyOf": [
            {
              "$ref": "#/$defs/Asset"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Auto-generated SVG pinout (CC-BY-4.0). Populated by tools/render_pinout.py."
        }
      },
      "required": [
        "datasheet"
      ],
      "title": "AssetBundle",
      "type": "object"
    },
    "BuildSpec": {
      "additionalProperties": false,
      "description": "Toolchain / memory configuration relevant to firmware build.",
      "properties": {
        "flash_mb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "External flash size in MB.",
          "title": "Flash Mb"
        },
        "frameworks": {
          "description": "Supported firmware frameworks for this board.",
          "items": {
            "enum": [
              "esp-idf",
              "arduino",
              "zephyr",
              "micropython",
              "platformio",
              "stm32-hal",
              "pico-sdk"
            ],
            "type": "string"
          },
          "title": "Frameworks",
          "type": "array"
        },
        "psram_mb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "External PSRAM in MB.",
          "title": "Psram Mb"
        },
        "ram_kb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "On-die RAM in KB.",
          "title": "Ram Kb"
        }
      },
      "required": [
        "frameworks"
      ],
      "title": "BuildSpec",
      "type": "object"
    },
    "CurrentDraw": {
      "additionalProperties": false,
      "description": "Typical and worst-case current consumption.",
      "properties": {
        "max_mA": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Worst-case operating current in mA.",
          "title": "Max Ma"
        },
        "sleep_uA": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deep-sleep current in \u00b5A.",
          "title": "Sleep Ua"
        },
        "typ_active_mA": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Typical active operating current in mA.",
          "title": "Typ Active Ma"
        }
      },
      "title": "CurrentDraw",
      "type": "object"
    },
    "Datasheet": {
      "additionalProperties": false,
      "description": "Manufacturer datasheet pointer with archival fallback.",
      "properties": {
        "archived_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "web.archive.org snapshot for offline / link-rot resilience.",
          "title": "Archived Url"
        },
        "primary_url": {
          "description": "Vendor-hosted authoritative URL.",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Primary Url",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the PDF when archived locally; null if linking only.",
          "title": "Sha256"
        }
      },
      "required": [
        "primary_url"
      ],
      "title": "Datasheet",
      "type": "object"
    },
    "Discovery": {
      "additionalProperties": false,
      "description": "Host-side discovery hooks for the device.",
      "properties": {
        "mac_oui": {
          "description": "MAC address OUIs assigned to this device's WiFi/BT/Ethernet (e.g. 'D0:EF:76').",
          "items": {
            "type": "string"
          },
          "title": "Mac Oui",
          "type": "array"
        },
        "usb": {
          "description": "USB IDs the device may enumerate as (native + bridge variants).",
          "items": {
            "$ref": "#/$defs/UsbId"
          },
          "title": "Usb",
          "type": "array"
        }
      },
      "title": "Discovery",
      "type": "object"
    },
    "Electrical": {
      "additionalProperties": false,
      "description": "Aggregate electrical specifications for a component.",
      "properties": {
        "current_draw": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurrentDraw"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Typical and worst-case current draw."
        },
        "logic": {
          "$ref": "#/$defs/LogicSpec"
        },
        "power_budget_mA": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total power budget at the board / module level in mA.",
          "title": "Power Budget Ma"
        },
        "vcc": {
          "$ref": "#/$defs/VccSpec"
        }
      },
      "required": [
        "vcc",
        "logic"
      ],
      "title": "Electrical",
      "type": "object"
    },
    "ExpansionHeader": {
      "additionalProperties": false,
      "description": "Through-hole or SMD header exposed for expansion / breakout.",
      "properties": {
        "name": {
          "description": "Header silkscreen designator (e.g. J1, header_left).",
          "title": "Name",
          "type": "string"
        },
        "pin_count": {
          "description": "Total pin count of the header.",
          "minimum": 1,
          "title": "Pin Count",
          "type": "integer"
        },
        "pins": {
          "description": "Pin.id values in physical order, starting at pin 1. Must match length pin_count.",
          "items": {
            "type": "string"
          },
          "title": "Pins",
          "type": "array"
        },
        "pitch_mm": {
          "description": "Pin-to-pin pitch in millimetres (typically 2.54).",
          "title": "Pitch Mm",
          "type": "number"
        }
      },
      "required": [
        "name",
        "pin_count",
        "pitch_mm",
        "pins"
      ],
      "title": "ExpansionHeader",
      "type": "object"
    },
    "ExternalRefs": {
      "additionalProperties": false,
      "description": "Distributor, catalog, and SBOM cross-references.",
      "properties": {
        "cpe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CPE 2.3 identifier (e.g. 'cpe:2.3:h:sensirion:sht41:-:*:*:*:*:*:*:*'). SBOM-grade.",
          "title": "Cpe"
        },
        "digikey_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digi-Key part number.",
          "title": "Digikey Pn"
        },
        "jlcpcb_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JLCPCB LCSC part number (e.g. C12345).",
          "title": "Jlcpcb Pn"
        },
        "mouser_pn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mouser part number.",
          "title": "Mouser Pn"
        },
        "nexar_part_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nexar GraphQL part ID.",
          "title": "Nexar Part Id"
        },
        "octopart_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Octopart canonical URL.",
          "title": "Octopart Url"
        },
        "purl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Package URL (purl) per spec (e.g. 'pkg:generic/sensirion/sht41'). SBOM-grade.",
          "title": "Purl"
        }
      },
      "title": "ExternalRefs",
      "type": "object"
    },
    "KicadRefs": {
      "additionalProperties": false,
      "description": "KiCad symbol, footprint, and 3D model pointers.",
      "properties": {
        "footprint": {
          "description": "Library:footprint path (e.g. hw-registry:DFN-4-1EP_2x2mm).",
          "title": "Footprint",
          "type": "string"
        },
        "model_3d": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "3D model path relative to repo root (typically under LFS).",
          "title": "Model 3D"
        },
        "symbol": {
          "description": "Library:symbol path (e.g. hw-registry:SHT41).",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "footprint"
      ],
      "title": "KicadRefs",
      "type": "object"
    },
    "LogicSpec": {
      "additionalProperties": false,
      "description": "Digital I/O voltage levels.",
      "properties": {
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Logic family identifier (e.g. CMOS, LVTTL).",
          "title": "Family"
        },
        "five_v_tolerant": {
          "default": false,
          "description": "True if I/O pins tolerate 5 V signals despite VCCIO < 5 V.",
          "title": "Five V Tolerant",
          "type": "boolean"
        },
        "voltage_v": {
          "description": "I/O voltage in volts (typically 1.8, 3.3, or 5.0).",
          "title": "Voltage V",
          "type": "number"
        }
      },
      "required": [
        "voltage_v"
      ],
      "title": "LogicSpec",
      "type": "object"
    },
    "Peripherals": {
      "additionalProperties": false,
      "description": "Counts of peripheral instances exposed by the board's main SoC.\n\nFlat int form is intentional. BLUEPRINT.md sec 3.1 shows a richer\nnested shape (``spi: { count: 4, max_clock_mhz: 80, user_usable: 2 }``);\nthe flat form aligns with Prompt 3's \"peripherals counts\" wording and\nis sufficient for the MVP. See BLUEPRINT.md Appendix A \"Section 3.1\nillustrative-only divergences\" for the rationale.\n\nTODO(post-mvp): consider migrating to nested {count, max_clock_*,\nuser_usable} once the conflict checker (Prompt 5) grows\nperipheral-allocation rules \u2014 at that point the extra metadata\nearns its keep.",
      "properties": {
        "adc": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adc"
        },
        "can": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Can"
        },
        "dac": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dac"
        },
        "ethernet": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ethernet"
        },
        "i2c": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "I2C"
        },
        "i2s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "I2S"
        },
        "pwm_channels": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pwm Channels"
        },
        "rmt": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmt"
        },
        "sd_mmc": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sd Mmc"
        },
        "spi": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spi"
        },
        "touch": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Touch"
        },
        "uart": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uart"
        },
        "usb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usb"
        }
      },
      "title": "Peripherals",
      "type": "object"
    },
    "Pin": {
      "additionalProperties": false,
      "description": "A single I/O pin on a chip, module, or board.",
      "properties": {
        "aliases": {
          "description": "Alternate human-friendly names (e.g. SDA, LED_BUILTIN).",
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "alt_functions": {
          "description": "Mux-selectable alternate functions in addition to the default.",
          "items": {
            "$ref": "#/$defs/AltFunction"
          },
          "title": "Alt Functions",
          "type": "array"
        },
        "default": {
          "description": "Default function on cold boot (e.g. gpio, JTAG_TDI, i2c_sda).",
          "title": "Default",
          "type": "string"
        },
        "exposed_as": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When this pin is re-exposed at a different level (e.g. chip pin PA0 brought out as module pin 'pin1'), the outer-level identifier.",
          "title": "Exposed As"
        },
        "id": {
          "description": "Pin identifier in the device's native namespace (e.g. GPIO5, PA0).",
          "title": "Id",
          "type": "string"
        },
        "package_pin": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical pin reference: int for numbered packages (QFN/QFP), str for grid refs like 'A4' (BGA), null for breakouts without a package mapping.",
          "title": "Package Pin"
        },
        "voltage_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Voltage rail powering this pin (e.g. VDDIO, VDDA, vdd_io).",
          "title": "Voltage Domain"
        }
      },
      "required": [
        "id",
        "default"
      ],
      "title": "Pin",
      "type": "object"
    },
    "Tested": {
      "additionalProperties": false,
      "description": "POC sign-off record. Required on every component.",
      "properties": {
        "by": {
          "description": "Engineer who signed off (email or GitHub handle).",
          "title": "By",
          "type": "string"
        },
        "date": {
          "description": "Sign-off date in ISO 8601 format (YYYY-MM-DD).",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "POC evidence \u2014 repo URL, photo path, or short note. Required by PR template for production-tested.",
          "title": "Evidence"
        },
        "status": {
          "description": "POC verification status.",
          "enum": [
            "stub",
            "verified",
            "production-tested"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "by",
        "date"
      ],
      "title": "Tested",
      "type": "object"
    },
    "UsbId": {
      "additionalProperties": false,
      "description": "USB Vendor / Product ID pair for a discovery interface.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What this VID/PID represents (e.g. 'native USB serial', 'CP210x bridge').",
          "title": "Description"
        },
        "pid": {
          "description": "USB Product ID, hex without 0x prefix.",
          "pattern": "^[0-9A-Fa-f]{4}$",
          "title": "Pid",
          "type": "string"
        },
        "vid": {
          "description": "USB Vendor ID, hex without 0x prefix (e.g. 303A for Espressif).",
          "pattern": "^[0-9A-Fa-f]{4}$",
          "title": "Vid",
          "type": "string"
        }
      },
      "required": [
        "vid",
        "pid"
      ],
      "title": "UsbId",
      "type": "object"
    },
    "VccSpec": {
      "additionalProperties": false,
      "description": "Supply voltage rail.",
      "properties": {
        "max_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum acceptable supply voltage in volts.",
          "title": "Max V"
        },
        "min_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum acceptable supply voltage in volts.",
          "title": "Min V"
        },
        "nominal_v": {
          "description": "Nominal supply voltage in volts.",
          "title": "Nominal V",
          "type": "number"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "usb-c",
                "usb-a",
                "barrel-jack",
                "pin-header",
                "poe",
                "battery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the rail comes from (board-level field; irrelevant for chips/sensors).",
          "title": "Source"
        }
      },
      "required": [
        "nominal_v"
      ],
      "title": "VccSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A physical board \u2014 dev kit, breakout, custom PCB.",
  "properties": {
    "apiVersion": {
      "const": "hwreg/v1",
      "description": "Schema API version. Pinned to hwreg/v1; bumping requires a v2 migration.",
      "title": "Apiversion",
      "type": "string"
    },
    "assets": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetBundle"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Datasheet and additional assets."
    },
    "build": {
      "$ref": "#/$defs/BuildSpec",
      "description": "Toolchain and memory configuration."
    },
    "code_owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "GitHub team or handle responsible for this component.",
      "title": "Code Owner"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional paragraph-form description (\u2264 500 chars). Use summary for the one-liner.",
      "title": "Description"
    },
    "discovery": {
      "$ref": "#/$defs/Discovery",
      "description": "Host-side discovery hooks (USB IDs, MAC OUIs)."
    },
    "electrical": {
      "$ref": "#/$defs/Electrical",
      "description": "Electrical specs."
    },
    "expansion_headers": {
      "description": "Physical headers exposed for expansion.",
      "items": {
        "$ref": "#/$defs/ExpansionHeader"
      },
      "title": "Expansion Headers",
      "type": "array"
    },
    "external_refs": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExternalRefs"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Distributor cross-refs."
    },
    "id": {
      "description": "Slug kind/vendor/part. MUST equal the relative path under library/ minus .yaml.",
      "pattern": "^[a-z]+/[a-z0-9-]+/[a-z0-9-]+$",
      "title": "Id",
      "type": "string"
    },
    "inherits_from": {
      "description": "Component refs (e.g. modules/espressif/esp32-s3-wroom-1@1.0.0) this board inherits from.",
      "items": {
        "pattern": "^[a-z]+/[a-z0-9-]+/[a-z0-9-]+(?:@\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)?$",
        "type": "string"
      },
      "title": "Inherits From",
      "type": "array"
    },
    "kicad": {
      "anyOf": [
        {
          "$ref": "#/$defs/KicadRefs"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "KiCad symbol/footprint refs."
    },
    "kind": {
      "const": "board",
      "default": "board",
      "title": "Kind",
      "type": "string"
    },
    "lifecycle": {
      "description": "Lifecycle stage. Drives deprecation surfacing for downstream consumers.",
      "enum": [
        "experimental",
        "stable",
        "deprecated",
        "eol",
        "archived"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "manufacturer_part_number": {
      "description": "Manufacturer P/N as printed on the board / box.",
      "title": "Manufacturer Part Number",
      "type": "string"
    },
    "peripherals": {
      "$ref": "#/$defs/Peripherals",
      "description": "Peripheral instance counts of the main SoC."
    },
    "pins": {
      "description": "Every exposed I/O pin with default and alt functions.",
      "items": {
        "$ref": "#/$defs/Pin"
      },
      "title": "Pins",
      "type": "array"
    },
    "reserved_pins": {
      "description": "Pin.id values reserved by on-board peripherals (e.g. USB D+/D-, flash).",
      "items": {
        "type": "string"
      },
      "title": "Reserved Pins",
      "type": "array"
    },
    "revision": {
      "description": "Component revision in SemVer 2.0. MAJOR=pin/electrical break, MINOR=behavior, PATCH=errata.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Revision",
      "type": "string"
    },
    "strapping_pins": {
      "description": "Pin.id values that latch boot mode at reset; constrain at design time.",
      "items": {
        "type": "string"
      },
      "title": "Strapping Pins",
      "type": "array"
    },
    "summary": {
      "description": "One-line human description (\u2264 120 characters).",
      "maxLength": 120,
      "title": "Summary",
      "type": "string"
    },
    "tags": {
      "description": "Free-form tags powering MCP search faceting (e.g. wifi, ble, lorawan, lx7).",
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "tested": {
      "$ref": "#/$defs/Tested",
      "description": "POC sign-off record."
    },
    "vendor": {
      "description": "Vendor slug from Zephyr's vendor-prefixes.txt.",
      "title": "Vendor",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "id",
    "revision",
    "summary",
    "tested",
    "lifecycle",
    "vendor",
    "manufacturer_part_number",
    "peripherals",
    "electrical",
    "build"
  ],
  "title": "Board",
  "type": "object"
}
